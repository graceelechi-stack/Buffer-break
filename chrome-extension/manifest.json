{
  "manifest_version": 3,
  "name": "FocusFlow: Workspace Optimizer",
  "short_name": "FocusFlow",
  "version": "0.1.0",
  "description": "Boost focus and streamline your workspace tabs. (Honestly? It's Buffer Break: it makes a tab look frozen so you can take a rest.)",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "FocusFlow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "freeze": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Start focus snapshot"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
